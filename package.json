{
  "name": "justwriting-one",
  "private": true,
  "version": "0.11.22",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build --outDir dist && npx tsx scripts/prerender.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "lint:changed": "FILES=$(git diff --name-only --diff-filter=ACMR origin/main -- '*.ts' '*.tsx' ':(exclude)scripts/**'); if [ -z \"$FILES\" ]; then echo 'lint:changed: no changed .ts/.tsx files vs origin/main'; else echo \"$FILES\" | NODE_OPTIONS=--max-old-space-size=6144 xargs eslint --max-warnings 0; fi",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:ci": "vitest run --coverage",
    "i18n:audit": "tsx scripts/i18n-audit.ts",
    "code-map": "tsx scripts/code-map.ts",
    "postulates": "node scripts/postulates.mjs --max-unmeasured 0",
    "postulates:db": "node scripts/postulates.mjs --require-db --max-unmeasured 0",
    "ai:eval": "node scripts/ai/citation_faithfulness.mjs",
    "sweep:sync": "bash scripts/sync-mutation-sweep.sh",
    "ci": "npm run typecheck && npm run lint && npm run test:ci"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.131",
    "@supabase/supabase-js": "^2.118.0",
    "ai": "^6.0.315",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "docx": "^9.14.0",
    "fuse.js": "^7.4.2",
    "idb": "^8.0.4",
    "isomorphic-dompurify": "^3.22.0",
    "jose": "^6.2.13",
    "jszip": "^3.10.1",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.12.0",
    "minisearch": "^7.2.0",
    "motion": "^12.23.24",
    "p-limit": "^7.3.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-helmet-async": "^3.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "react-virtuoso": "^4.18.19",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-istanbul": "^4.1.12",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "esbuild": "^0.28.0",
    "fake-indexeddb": "^6.2.6",
    "glob": "^13.0.6",
    "globals": "^14.0.0",
    "jsdom": "^29.0.1",
    "knip": "^6.43.0",
    "prettier": "^3.9.10",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "dompurify": "^3.4.13",
    "minimatch": "^10.2.3"
  }
}
