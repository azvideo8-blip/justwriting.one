# deploy/.env.example — environment variables for the VPS deployment.
# Copy to /opt/justwriting/.env and fill in actual values.
# NEVER commit the filled-in file.

# Firebase / Firestore
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=
FIRESTORE_DATABASE_ID=

# API server
PORT=3000

# AI provider (RouterAI, OpenAI-compatible) — for /api/chat
OPENROUTER_API_KEY=
AI_BASE_URL=https://routerai.ru/api/v1

# Sentry (error tracking)
SENTRY_DSN=

# PostHog (analytics)
POSTHOG_API_KEY=
