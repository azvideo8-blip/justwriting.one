# deploy/.env.example — environment variables for the VPS deployment.
# Copy to /opt/justwriting/.env and fill in actual values.
# NEVER commit the filled-in file.

# Firebase / Firestore
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=
FIRESTORE_DATABASE_ID=

# API server
PORT=3000

# OpenAI (for /api/chat)
OPENAI_API_KEY=

# Sentry (error tracking)
SENTRY_DSN=

# PostHog (analytics)
POSTHOG_API_KEY=
