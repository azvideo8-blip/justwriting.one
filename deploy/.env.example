# deploy/.env.example — environment variables for the VPS deployment.
# Copy to /opt/justwriting/api/.env (EnvironmentFile in justwriting.service) and fill in actual values.
# NEVER commit the filled-in file.

# API server
PORT=3000
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=  # SERVICE_ROLE_KEY from /opt/justwriting/supabase/.env for admin GoTrue API
# Должно совпадать с GOTRUE_JWT_ISSUER контейнера supabase-auth символ в символ.
# Расхождение — это не «чуть строже проверка», а отказ входа всем сразу: служба
# отвергнет любой токен. Пустое значение отключает сверку издателя, остальные
# проверки (алгоритм, аудитория, срок, sub) работают в любом случае.
# AUDIT-L4: явный гейт issuer-проверки (true в проде)
REQUIRE_JWT_ISSUER=true
SUPABASE_JWT_ISS=https://justwriting.ru/auth/v1
SUPABASE_URL=
# NOTE the username: port 5432 is published by Supavisor, the connection pooler,
# not by Postgres itself. Supavisor demands a tenant-qualified user — plain
# `postgres` is rejected with "no tenant identifier provided". The tenant is
# POOLER_TENANT_ID from the Supabase .env.
DATABASE_URL=postgres://postgres.<POOLER_TENANT_ID>:<POSTGRES_PASSWORD>@127.0.0.1:5432/postgres
# Secret salt for telemetry row keys (sha256(uid:pepper)); without it sendTelemetry fails.
TELEMETRY_ID_PEPPER=<random secret>

# AI provider (RouterAI, OpenAI-compatible) — for /api/chat and analysis
OPENROUTER_API_KEY=
AI_BASE_URL=https://routerai.ru/api/v1
# Local embeddings server; the service POSTs to <this>/embeddings. Unset = embeddings go to AI_BASE_URL (third-party provider).
AI_EMBED_BASE_URL=http://127.0.0.1:<port>/v1
# Global daily request & token limits (RPD / TPD)
AI_TIER_RPD=10000
AI_TIER_TPD=25000000
# Spend ceiling in Rubles: optional hard cap on daily AI cost (e.g. 100 RUB/day)
AI_DAILY_SPEND_LIMIT_RUB=
AI_RUB_PER_1M_TOKENS=30

# ── Supabase / Auth Registration Control ───────────────────────────────────
# For single-user / private self-hosted instances:
# Once the admin user is registered, you can disable public registrations
# in /opt/justwriting/supabase/.env by setting:
#   DISABLE_SIGNUP=true
# (or GOTRUE_DISABLE_SIGNUP=true in docker-compose.yml)
# For open / multi-user instances, leave signups enabled and rely on Nginx rate limiting.

