[Unit]
Description=JustWriting API — AI endpoints and CSP reports
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=justwriting
Group=justwriting
WorkingDirectory=/opt/justwriting/api

# A single esbuild bundle, not the TypeScript tree. Bundling sidesteps module
# resolution entirely — importing across package boundaries fails at load time
# with a clean tsc.
#
# Dependencies stay external (pg, zod, langfuse, isomorphic-dompurify) — jsdom,
# which isomorphic-dompurify pulls in, reads files from its own package at
# runtime and cannot be inlined.
ExecStart=/usr/bin/node /opt/justwriting/api/server.mjs

Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Edit /opt/justwriting/api/.env, not this file.
EnvironmentFile=/opt/justwriting/api/.env
Environment=NODE_ENV=production

# Hardening. The service needs no write access anywhere: state lives in Postgres.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
