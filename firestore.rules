rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: userId (auth.uid)
    // Fields:
    //   - uid: string (required, 1-128 chars)
    //   - email: string (required, valid email format)
    //   - nickname: string (optional, 1-50 chars)
    //   - role: string (optional, enum: ['user', 'admin'])
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Admin check: checks the secure custom claim token, which the client cannot write.
    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    function isValidUserCreate(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.keys().hasOnly([
               'uid', 'email', 'nickname', 'encryptionSalt', 'encryptedDataKey',
               'encryptionMeta',
               'labels', 'earnedAchievements', 'totalWordCount', 'sessionsCount',
               'streakDays', 'totalDuration', 'avgWpm', 'avgSessionWords',
               'privacyAcceptedAt', 'privacyVersion',
               'aiPortrait', '_encrypted'
             ]) &&
             data.uid is string && data.uid.size() > 0 &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() > 0 &&
             (!('nickname' in data) || (data.nickname is string && data.nickname.size() <= 100)) &&
             (!('encryptionSalt' in data) || data.encryptionSalt is string) &&
             (!('encryptedDataKey' in data) || data.encryptedDataKey is string) &&
             (!('encryptionMeta' in data) || data.encryptionMeta is map) &&
             (!('privacyAcceptedAt' in data) || data.privacyAcceptedAt is timestamp) &&
             (!('privacyVersion' in data) || data.privacyVersion is number) &&
             (!('aiPortrait' in data) || (data.aiPortrait is string && data.aiPortrait.size() <= 100000)) &&
             (!('_encrypted' in data) || data._encrypted is bool) &&
             !('role' in data);
    }

    function isValidUserUpdate(data, changedKeys) {
      // Only validate the keys that are actually being changed.
      // This avoids rejecting users who have legacy fields in their profile.
      let allowedWriteKeys = [
        'nickname', 'encryptionSalt', 'encryptedDataKey',
        'encryptionMeta',
        'labels', 'earnedAchievements', 'totalWordCount', 'sessionsCount',
        'streakDays', 'totalDuration', 'avgWpm', 'avgSessionWords',
        'privacyAcceptedAt', 'privacyVersion',
        'aiPortrait', '_encrypted'
      ];
      return changedKeys.hasOnly(allowedWriteKeys) &&
             (!changedKeys.hasAny(['nickname']) || (data.nickname is string && data.nickname.size() <= 100)) &&
             (!changedKeys.hasAny(['encryptionSalt']) || data.encryptionSalt is string) &&
             (!changedKeys.hasAny(['encryptedDataKey']) || data.encryptedDataKey is string) &&
             (!changedKeys.hasAny(['encryptionMeta']) || data.encryptionMeta is map) &&
             (!changedKeys.hasAny(['privacyAcceptedAt']) || data.privacyAcceptedAt is timestamp) &&
             (!changedKeys.hasAny(['privacyVersion']) || data.privacyVersion is number) &&
             (!changedKeys.hasAny(['aiPortrait']) || (data.aiPortrait is string && data.aiPortrait.size() <= 100000)) &&
             (!changedKeys.hasAny(['_encrypted']) || data._encrypted is bool);
    }

    function isValidDraft(data) {
      return data.keys().hasAll(['userId', 'content', 'updatedAt']) &&
             data.keys().hasOnly([
               'userId', 'content', 'updatedAt', 'title',
               'pinnedThoughts', 'tags', '_encrypted',
               'seconds', 'wpm', 'wordCount', 'initialWordCount',
               'activeSessionId', 'sessionStartTime', 'accumulatedDuration',
               'totalPauseSeconds', 'savedDocumentId', 'labelId'
             ]) &&
             data.userId == request.auth.uid &&
             data.content is string && data.content.size() <= 100000 &&
             (data.updatedAt is number || data.updatedAt is timestamp) &&
             (!('title' in data) || (data.title is string && data.title.size() <= 200)) &&
             // When E2E encryption is on, maybeEncrypt() JSON-stringifies the whole
             // array and encrypts it (cryptoHelpers.ts), so it arrives as an opaque
             // string — the item count is not observable server-side. Accept both
             // shapes: a plaintext list capped by items, or a ciphertext capped by
             // size. Rejecting the string form silently broke every draft save for
             // encrypted users with permission-denied.
             (!('pinnedThoughts' in data) ||
               (data.pinnedThoughts is list && data.pinnedThoughts.size() <= 20) ||
               (('_encrypted' in data) && data._encrypted == true &&
                data.pinnedThoughts is string && data.pinnedThoughts.size() <= 50000)) &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 10)) &&
             (!('_encrypted' in data) || data._encrypted is bool) &&
             (!('seconds' in data) || data.seconds is number) &&
             (!('wpm' in data) || data.wpm is number) &&
             (!('wordCount' in data) || data.wordCount is number) &&
             (!('initialWordCount' in data) || data.initialWordCount is number) &&
             (!('activeSessionId' in data) || data.activeSessionId is string || data.activeSessionId == null) &&
             (!('sessionStartTime' in data) || data.sessionStartTime is number || data.sessionStartTime == null) &&
             (!('accumulatedDuration' in data) || data.accumulatedDuration is number) &&
             (!('totalPauseSeconds' in data) || data.totalPauseSeconds is number) &&
             (!('savedDocumentId' in data) || data.savedDocumentId is string || data.savedDocumentId == null) &&
             (!('labelId' in data) || data.labelId is string || data.labelId == null);
    }

    // User profiles
    match /users/{userId} {
      // Allow users to read their own profile, or admins to read any profile.
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      
      // Allow creation of a profile. 
      allow create: if isOwner(userId) && isValidUserCreate(request.resource.data);
      
      // Allow updates to a profile.
      // The role field MUST NOT be modified by the client.
      // We check only the keys that actually changed (diff-based), not the entire document.
      allow update: if isOwner(userId) && 
                      isValidUserUpdate(request.resource.data, request.resource.data.diff(resource.data).affectedKeys()) &&
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid', 'email']);
    }

    // Connection test — restricted to specific ping doc only
    match /_connection_test_/ping {
      allow read: if isAuthenticated();
    }

    // Drafts
    match /drafts/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) && isValidDraft(request.resource.data);
      allow delete: if isOwner(userId);
    }

    // Documents (subcollection of users)
    function isValidDocumentCreate(data) {
      return data.keys().hasAll(['userId', 'title']) &&
             data.userId is string &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 200 &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 10)) &&
             (!('labelId' in data) || data.labelId is string || data.labelId == null);
    }

    // S-12: hasOnly + type checks for document updates.
    // Field set derived from src/core/services/DocumentService.ts:
    //   updateTitle → title
    //   updateTags / renameTagInAllDocs / removeTagFromAllDocs → tags
    //   updateLabelId / clearLabelFromAllDocs → labelId
    //   updateDocumentAfterSession → totalWords, totalDuration, currentVersion,
    //                                mood, sessionsCount, lastSessionAt
    //   updateDate → firstSessionAt, lastSessionAt
    function isValidDocumentUpdate(data) {
      // NOTE: on update, request.resource.data is the FULL merged document, so
      // hasOnly must list every field a document carries — including `userId`,
      // set at creation (DocumentService.createDocument). `userId` is pinned to
      // the auth uid so it cannot be tampered to another user's id (S-12).
      return data.keys().hasOnly([
               'userId', 'title', 'tags', 'labelId', 'totalWords', 'totalDuration',
               'currentVersion', 'mood', 'sessionsCount', 'firstSessionAt', 'lastSessionAt'
             ]) &&
             data.userId == request.auth.uid &&
             (!('title' in data) || (data.title is string && data.title.size() <= 200)) &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 10)) &&
             (!('labelId' in data) || data.labelId is string || data.labelId == null) &&
             (!('totalWords' in data) || (data.totalWords is number && data.totalWords >= 0)) &&
             (!('totalDuration' in data) || (data.totalDuration is number && data.totalDuration >= 0)) &&
             (!('currentVersion' in data) || (data.currentVersion is number && data.currentVersion >= 0)) &&
             (!('mood' in data) || (data.mood is string && data.mood.size() <= 50)) &&
             (!('sessionsCount' in data) || (data.sessionsCount is number && data.sessionsCount >= 0)) &&
             (!('firstSessionAt' in data) || data.firstSessionAt is timestamp) &&
             (!('lastSessionAt' in data) || data.lastSessionAt is timestamp);
    }

    function isValidVersion(data) {
      return data.keys().hasAll(['documentId', 'content', 'wordCount']) &&
             data.keys().hasOnly([
               'documentId', 'content', 'wordCount', 'userId', 'version',
               'wordsAdded', 'charsAdded', 'duration', 'wpm',
               'goalWords', 'goalTime', 'goalReached',
               'savedAt', 'sessionStartedAt', '_encrypted', 'mood'
             ]) &&
              data.documentId is string &&
              data.content is string && data.content.size() <= 700000 &&
             data.wordCount is number && data.wordCount >= 0 &&
             (!('mood' in data) || (data.mood is string && data.mood.size() <= 50)) &&
         (!('userId' in data) || data.userId == request.auth.uid);
    }

    match /users/{userId}/documents/{documentId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidDocumentCreate(request.resource.data);
      allow update: if isOwner(userId) && isValidDocumentUpdate(request.resource.data);
      allow delete: if isOwner(userId);

      match /versions/{versionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidVersion(request.resource.data);
        allow update: if isOwner(userId) && isValidVersion(request.resource.data);
        allow delete: if isOwner(userId);
      }
    }

    // S-11: Summary validation.
    // Field set derived from src/features/ai/services/AISummaryService.ts:
    //   saveSummaryToCloud writes { ...summary } via setDoc({merge:true}) after
    //   maybeEncrypt, which may add _encrypted:true.
    //   Summary fields: documentId, tone, frequentWords, insights, themes,
    //   extractedFacts, mentionedPeople, processedAt, _encrypted
    // Field set derived from AIDocumentSummary (localDb.ts) and what
    // saveSummaryToCloud actually sends: it spreads the whole record, so every
    // optional field reaches Firestore. maybeEncrypt turns the STRING_FIELDS
    // into ciphertext and JSON-stringifies each ARRAY_FIELD into a single
    // ciphertext string, so encrypted arrays arrive as strings and the item
    // count is not observable server-side — accept both shapes, capping the
    // ciphertext by size instead. Omitting a field the client sends denies the
    // whole write, which is how summaries silently stopped syncing.
    function isValidSummary(data) {
      return data.keys().hasOnly([
               'documentId', 'summary', 'tone', 'frequentWords', 'authorPhrases',
               'insights', 'quotableSentence', 'themes', 'extractedFacts',
               'mentionedPeople', 'processedAt', 'commitments', 'valence',
               'arousal', 'echo', 'contentHash', 'eventDate', 'promptVersion',
               '_encrypted'
             ]) &&
             (!('documentId' in data) || data.documentId is string) &&
             (!('summary' in data) || (data.summary is string && data.summary.size() <= 20000)) &&
             (!('tone' in data) || (data.tone is string && data.tone.size() <= 5000)) &&
             (!('echo' in data) || (data.echo is string && data.echo.size() <= 5000)) &&
             (!('eventDate' in data) || (data.eventDate is string && data.eventDate.size() <= 500)) &&
             (!('quotableSentence' in data) || (data.quotableSentence is string && data.quotableSentence.size() <= 5000)) &&
             (!('contentHash' in data) || (data.contentHash is string && data.contentHash.size() <= 500)) &&
             (!('frequentWords' in data) || (data.frequentWords is list && data.frequentWords.size() <= 50) || (data.frequentWords is string && data.frequentWords.size() <= 20000)) &&
             (!('authorPhrases' in data) || (data.authorPhrases is list && data.authorPhrases.size() <= 20) || (data.authorPhrases is string && data.authorPhrases.size() <= 20000)) &&
             (!('insights' in data) || (data.insights is list && data.insights.size() <= 50) || (data.insights is string && data.insights.size() <= 20000)) &&
             (!('themes' in data) || (data.themes is list && data.themes.size() <= 50) || (data.themes is string && data.themes.size() <= 20000)) &&
             (!('extractedFacts' in data) || (data.extractedFacts is list && data.extractedFacts.size() <= 50) || (data.extractedFacts is string && data.extractedFacts.size() <= 20000)) &&
             (!('commitments' in data) || (data.commitments is list && data.commitments.size() <= 50) || (data.commitments is string && data.commitments.size() <= 20000)) &&
             (!('mentionedPeople' in data) || (data.mentionedPeople is list && data.mentionedPeople.size() <= 100)) &&
             (!('processedAt' in data) || data.processedAt is number) &&
             (!('valence' in data) || data.valence is number) &&
             (!('arousal' in data) || data.arousal is number) &&
             (!('promptVersion' in data) || data.promptVersion is number) &&
             (!('_encrypted' in data) || data._encrypted is bool);
    }

    // S-11: Embedding validation.
    // Field set derived from src/features/ai/services/AIEmbeddingService.ts:
    //   saveEmbeddingToCloud writes payload via setDoc({merge:true}) after
    //   maybeEncrypt, which may add _encrypted:true.
    //   Payload fields: documentId, vectorsJson, chunkTextsJson, model, dim,
    //   contentHash, processedAt, schemaV, _encrypted
    function isValidEmbedding(data) {
      // NOTE: written via setDoc({merge:true}); legacy docs may retain the
      // single-vector `vectorJson` field (see AIEmbeddingService.parseVectors),
      // so it must stay in hasOnly or re-embedding a legacy doc would be denied.
      return data.keys().hasOnly([
               'documentId', 'vectorsJson', 'vectorJson', 'chunkTextsJson', 'model', 'dim',
               'contentHash', 'processedAt', 'schemaV', '_encrypted'
             ]) &&
             (!('documentId' in data) || data.documentId is string) &&
             // Caps match MAX_CLOUD_EMBEDDING_BYTES in AIEmbeddingService, which
             // is what the client refuses to send. A tighter cap here just turns
             // "too big, skip it" into a permission-denied the client cannot see
             // coming — at 4096 dims a multi-chunk note passed the old 500k limit.
             (!('vectorsJson' in data) || (data.vectorsJson is string && data.vectorsJson.size() <= 1000000)) &&
             (!('vectorJson' in data) || (data.vectorJson is string && data.vectorJson.size() <= 1000000)) &&
             (!('chunkTextsJson' in data) || (data.chunkTextsJson is string && data.chunkTextsJson.size() <= 1000000)) &&
             // model and contentHash are encrypted, so the ciphertext is well
             // longer than the plaintext model name or sha256 hex.
             (!('model' in data) || (data.model is string && data.model.size() <= 1000)) &&
             (!('dim' in data) || (data.dim is number && data.dim >= 0 && data.dim <= 8192)) &&
             (!('contentHash' in data) || (data.contentHash is string && data.contentHash.size() <= 1000)) &&
             (!('processedAt' in data) || data.processedAt is number) &&
             (!('schemaV' in data) || data.schemaV is number || data.schemaV == null) &&
             (!('_encrypted' in data) || data._encrypted is bool);
    }

    match /users/{userId}/summaries/{documentId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidSummary(request.resource.data);
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/embeddings/{documentId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidEmbedding(request.resource.data);
      allow delete: if isOwner(userId);
    }

    // AI daily limit + cooldown — admin SDK only
    match /aiDailyLimit/{uid} {
      allow read, write: if false;
    }

    match /aiCooldown/{uid} {
      allow read, write: if false;
    }

    // AI usage — client can read own usage, admin SDK writes
    match /aiUsage/{uid}/daily/{date} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Project-wide AI usage aggregate — admin SDK only
    match /aiGlobalDaily/{date} {
      allow read, write: if false;
    }

    // S-10: Telemetry validation.
    // SEC-54: Anonymized telemetry — read for admin only, writes routed via rate-limited sendTelemetry Cloud Function (Admin SDK).
    match /anonymizedTelemetry/{telemetryId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

  }
}

