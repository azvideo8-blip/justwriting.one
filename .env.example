# Sentry DSN for error monitoring
VITE_SENTRY_DSN=

# PostHog analytics (get key from posthog.com or self-hosted instance)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
VITE_RECAPTCHA_SITE_KEY=
# Local dev: set to any string to get an App Check debug token printed in the
# browser console, then register it in Firebase Console → App Check → Debug tokens.
# VITE_APPCHECK_DEBUG_TOKEN=

# ─── Server-side AI routing (NOT Vite — set in Vercel env + Firebase Functions) ───
DATABASE_URL=
# The name still says OPENROUTER because it is bound by name in every functions/src/ai/*
# secrets: [...] declaration; the value is now a RouterAI key.
# OPENROUTER_API_KEY=
# Require a Firebase App Check token on /api/chat (Vercel only). "true" to enforce.
# APP_CHECK_ENFORCE=
# Provider base URL. Defaults to RouterAI; set to https://openrouter.ai/api/v1 to go back.
# AI_BASE_URL=https://routerai.ru/api/v1
# Override the chat model id (defaults to DeepSeek v4 flash).
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# Override the embedding model id. WARNING: changing this invalidates every stored
# vector and forces a full re-embed of all notes — see docs before touching it.
# OPENROUTER_EMBED_MODEL=qwen/qwen3-embedding-8b

# ─── Firebase App Check (Vercel endpoint only) ───
# Cloud Functions use enforceAppCheck: true on the callable definition directly.
# For /api/chat set this to 'true' in Vercel env vars for production.
# Leave unset or 'false' for local development and testing.
# APP_CHECK_ENFORCE=true
