# Supabase Configuration
# Note: E2E tests and prerender require VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY
# (any values, even dummy ones for local offline runs, e.g. http://localhost:54321 / dummy).
VITE_SUPABASE_URL=https://justwriting.ru
VITE_SUPABASE_ANON_KEY=      # ANON_KEY from /opt/justwriting/supabase/.env

# ─── Server-side AI routing & API (set in /opt/justwriting/api/.env on VPS) ───
DATABASE_URL=
# JWT verification for VPS API endpoints. SUPABASE_JWT_ISS is mandatory in production
# and when DATABASE_URL is configured for local API runs.
# SUPABASE_JWT_SECRET=
# SUPABASE_JWT_ISS=https://justwriting.ru/auth/v1
# Явный гейт issuer-проверки (AUDIT-L4). В деплое — true.
# REQUIRE_JWT_ISSUER=true
# The name still says OPENROUTER for historical reasons; the value is now a RouterAI key.
# OPENROUTER_API_KEY=
# Provider base URL. Defaults to RouterAI; set to https://openrouter.ai/api/v1 to go back.
# AI_BASE_URL=https://routerai.ru/api/v1
# Override the model for service calls (summaries, punctuation, rerank, profile).
# Defaults to DeepSeek v4 flash.
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# Override the model for live dialogue turns (streaming chat, reasoning mode and
# its fallback). Defaults to DeepSeek v4.1 flash.
# AI_CHAT_MODEL=deepseek/deepseek-v4.1-flash
# Override the embedding model id. WARNING: changing this invalidates every stored
# vector and forces a full re-embed of all notes — see docs before touching it.
# OPENROUTER_EMBED_MODEL=qwen/qwen3-embedding-8b
